# Facebook App Configuration (your platform app — not per-client)
APP_ID=ADD_APP_ID_HERE
APP_SECRET=ADD_APP_SECRET_HERE
VERIFY_TOKEN=ADD_VERIFY_TOKEN_HERE

# Embedded Signup — Meta → WhatsApp → Embedded Signup Builder → Configuration ID
WHATSAPP_CONFIGURATION_ID=

# Public URL of this server (use ngrok HTTPS URL in dev for OAuth)
# Example: BASE_URL=https://abc123.ngrok-free.app
BASE_URL=http://localhost:8080

# OAuth redirect for server-side flow (/auth/whatsapp). Defaults to BASE_URL/auth/callback
# For ngrok: OAUTH_REDIRECT_URI=https://abc123.ngrok-free.app/auth/callback
OAUTH_REDIRECT_URI=

# Server Configuration
PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379

# Jasper auto-reply (keep false for manual chat testing)
CHAT_AUTO_REPLY=false

# PIN de 6 dígitos para registrar el número en Cloud API tras login Meta (Embedded Signup)
WHATSAPP_REGISTER_PIN=123456

# Legacy optional fallbacks (not needed if using /connect)
# ACCESS_TOKEN=
# PHONE_NUMBER_ID=

# --- Meta App Dashboard setup (one-time) ---
# 1. Facebook Login for Business → Valid OAuth Redirect URIs:
#    - https://YOUR-NGROK.ngrok-free.app/connect
#    - http://localhost:8080/connect
#    - https://YOUR-NGROK.ngrok-free.app/auth/callback  (redirect flow)
# 2. Settings → Basic → Allowed Domains for the JavaScript SDK:
#    - localhost
#    - YOUR-NGROK.ngrok-free.app
# 3. WhatsApp → Embedded Signup → copy Configuration ID → WHATSAPP_CONFIGURATION_ID above
