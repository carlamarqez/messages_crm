# Facebook App Configuration (your platform app — not per-client)
APP_ID=ADD_APP_ID_HERE
APP_SECRET=ADD_APP_SECRET_HERE
VERIFY_TOKEN=ADD_VERIFY_TOKEN_HERE

# Embedded Signup (Technology Provider) — OBLIGATORIO para popup de Meta
# Guía paso a paso: docs/EMBEDDED_SIGNUP.md
# Meta → WhatsApp → Embedded Signup Builder → Configuration ID
WHATSAPP_CONFIGURATION_ID=

# Public URL of this server
# Local:  BASE_URL=http://localhost:8080
# Render: BASE_URL=https://messages-crm.onrender.com
BASE_URL=http://localhost:8080

# OAuth redirect (server-side fallback). Defaults to BASE_URL/auth/callback
# Render: OAUTH_REDIRECT_URI=https://messages-crm.onrender.com/auth/callback
OAUTH_REDIRECT_URI=

# Server Configuration
PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379

# Jasper auto-reply (keep false for manual chat testing)
CHAT_AUTO_REPLY=false

# PIN de 6 dígitos para registrar el número en Cloud API tras login Meta (Embedded Signup)
WHATSAPP_REGISTER_PIN=123456

# Legacy optional fallbacks (not needed if using /connect)
# ACCESS_TOKEN=
# PHONE_NUMBER_ID=

# --- Meta App Dashboard (ver docs/EMBEDDED_SIGNUP.md) ---
# 1. App Domains: tu-dominio.onrender.com
# 2. Facebook Login → Valid OAuth Redirect URIs:
#    - https://tu-dominio.onrender.com/connect
#    - https://tu-dominio.onrender.com/auth/callback
# 3. Allowed Domains (JS SDK): tu-dominio.onrender.com (+ localhost en dev)
# 4. WhatsApp → Embedded Signup → Configuration ID → WHATSAPP_CONFIGURATION_ID
